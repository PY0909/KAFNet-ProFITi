\f2\b \cf0 2.2 \uc0\u23454 \u36341 \u20215 \u20540 
\f0\b0 \
\uc0\u26412 \u30740 \u31350 \u38754 \u21521 \u31354 \u27668 \u21387 \u32553 \u26426 \u12289 \u33322 \u31354 \u21457 \u21160 \u26426 \u12289 \u28082 \u21387 \u31995 \u32479 \u20197 \u21450 \u36807 \u31243 \u24037 \u19994 \u35013 \u32622 \u31561 \u20856 \u22411 \u24037 \u19994 \u35774 \u22791 \u65292 \u20851 \u27880 \u22797 \u26434 \u24037 \u19994 \u30417 \u27979 \u26465 \u20214 \u19979 \u30340 \u22810 \u20256 \u24863 \u22120 \u29366 \u24577 \u39044 \u27979 \u19982 \u39118 \u38505 \u35780 \u20272 \u38382 \u39064 \u12290 \u27492 \u31867 \u35774 \u22791 \u36890 \u24120 \u20855 \u26377 \u36830 \u32493 \u36816 \u34892 \u26102 \u38388 \u38271 \u12289 \u31995 \u32479 \u32806 \u21512 \u20851 \u31995 \u22797 \u26434 \u20197 \u21450 \u32500 \u25252 \u25104 \u26412 \u39640 \u31561 \u29305 \u28857 \u65292 \u19968 \u26086 \u35774 \u22791 \u36827 \u20837 \u24322 \u24120 \u29366 \u24577 \u65292 \u20572 \u26426 \u25439 \u22833 \u12289 \u32500 \u25252 \u25104 \u26412 \u21644 \u23433 \u20840 \u39118 \u38505 \u20250 \u38543 \u26102 \u38388 \u25345 \u32493 \u32047 \u31215 \u12290 \u20256 \u32479 \u23450 \u26399 \u32500 \u25252 \u26041 \u24335 \u23481 \u26131 \u36896 \u25104 \u36807 \u24230 \u32500 \u20462 \u25110 \u28431 \u26816 \u65292 \u32780 \u25925 \u38556 \u21518 \u32500 \u20462 \u21448 \u38590 \u20197 \u21450 \u26102 \u36991 \u20813 \u29983 \u20135 \u25439 \u22833 \u12290 \u22240 \u27492 \u65292 \u22522 \u20110 \u22810 \u20256 \u24863 \u22120 \u29366 \u24577 \u39044 \u27979 \u30340 \u39118 \u38505 \u35780 \u20272 \u26041 \u27861 \u65292 \u26377 \u21161 \u20110 \u22312 \u25925 \u38556 \u21457 \u29983 \u21069 \u24418 \u25104 \u39044 \u35686 \u20381 \u25454 \u65292 \u20026 \u35774 \u22791 \u32500 \u25252 \u25490 \u31243 \u12289 \u22791 \u20214 \u31649 \u29702 \u21644 \u36816 \u34892 \u31574 \u30053 \u35843 \u25972 \u25552 \u20379 \u25968 \u25454 \u25903 \u25345 \u65292 \u23545 \u24037 \u19994 \u39044 \u27979 \u24615 \u32500 \u25252 \u20855 \u26377 \u36739 \u26126 \u30830 \u30340 \u24