\f1\fs24 \cf0 \uc0\u26412 \u30740 \u31350 \u38754 \u21521 \u24037 \u19994 \u24322 \u27493 \u22810 \u20256 \u24863 \u22120 \u29366 \u24577 \u39044 \u27979 \u19982 \u39118 \u38505 \u35780 \u20272 \u38382 \u39064 \u65292 \u22260 \u32469 \u24322 \u27493 \u35266 \u27979 \u26465 \u20214 \u19979 \u30340 \u29366 \u24577 \u34920 \u31034 \u12289 \u22810 \u21464 \u37327 \u32852 \u21512 \u27010 \u29575 \u24314 \u27169 \u20197 \u21450 \u39118 \u38505 \u25512 \u26029 \u26426 \u21046 \u23637 \u24320 \u30740 \u31350 \u65292 \u20998 \u26512 \u35266 \u27979 \u36807 \u31243 \u24314 \u27169 \u12289 \u32852 \u21512 \u29366 \u24577 \u20998 \u24067 \u23398 \u20064 \u21644 \u27010 \u29575 \u39118 \u38505 \u35780 \u20272 \u22312 \u24037 \u19994 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u20013 \u30340 \u20316 \u29992 \u12290 \u29616 \u26377 \u24037 \u19994 \u29366 \u24577 \u39044 \u27979 \u30740 \u31350 \u24050 \u32463 \u35777 \u26126 \u28145 \u24230 \u27169 \u22411 \u33021 \u22815 \u20174 \u22810 \u20256 \u24863 \u22120 \u21382 \u21490 \u24207 \u21015 \u20013 \u23398 \u20064 \u36864 \u21270 \u29305 \u24449 \u65292 \u24182 \u22312 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u12289 \u25925 \u38556 \u35786 \u26029 \u21644 \u20581 \u24247 \u29366 \u24577 \u20998 \u26512 \u20013 \u21462 \u24471 \u36739 \u22909 \u25928 \u26524 \u65292 \u20294 \u22312 \u24322 \u27493 \u32570 \u22833 \u26465 \u20214 \u24314 \u27169 \u12289 \u22810 \u21464 \u37327 \u32852 \u21512 \u19981 \u30830 \u23450 \u24615 \u34920 \u36798 \u20197 \u21450 \u39044 \u27979 \u20998 \u24067 \u19982 \u39118 \u38505 \u35780 \u20272 \u20043 \u38388 \u30340 \u32479 \u19968 \u32852 \u31995 \u26041 \u38754 \u20173 \u23384 \u22312 \u19981 \u36275 \u12290 \u26412 \u25991 \u20174 \u36825 \u20123 \u38382 \u39064 \u20986 \u21457 \u65292 \u23558 \u24037 \u19994 \u35774 \u22791 \u35266 \u27979 \u36807 \u31243 \u12289 \u26410 \u26469 \u29366 \u24577 \u28436 \u21270 \u19982 \u39118 \u38505 \u27010 \u29575 \u25512 \u26029 \u32435 \u20837 \u32479 \u19968 \u30340  KST ProbFlow \u27010 \u29575 \u39044 \u27979 \u35270 \u35282 \u65292 \u26377 \u21161 \u20110 \u36827 \u19968 \u27493 \u26126 \u30830 \u24037 \u19994 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u20013 \u35266 \u27979 \u20449 \u24687 \u12289 \u29366 \u24577 \u20449 \u24687 \u19982 \u39118 \u38505 \u20449 \u24687 \u20043 \u38388 \u30340 \u20316 \u29992 \u20851 \u31995 \u12290 \
\pard\pardeftab720\fi420\pardirnatural\qj\partightenfactor0

\f0\fs21 \cf0 \uc0\u22312 \u24322 \u27493 \u35266 \u27979 \u24314 \u27169 \u26041 \u38754 \u65292 \u26412 \u30740 \u31350 \u23581 \u35797 \u23558 \u26102 \u38388 \u38388 \u38548 \u12289 \u35266 \u27979 \u25513 \u30721 \u12289 \u36890 \u36947 \u36523 \u20221 \u20197 \u21450 \u24037 \u20917 \u29366 \u24577 \u20316 \u20026 \u36755 \u20837 \u34920 \u31034 \u30340 \u19968 \u37096 \u20998 \u65292 \u32780 \u19981 \u26159 \u20165 \u36890 \u36807 \u39044 \u22788 \u29702 \u38454 \u27573 \u23545 \u32570 \u22833 \u25968 \u25454 \u36827 \u34892 \u25554 \u34917 \u25110 \u35268 \u21017 \u21270 \u22788 \u29702 \u12290 \u35813 \u24605 \u36335 \u33021 \u22815 \u20351 \u27169 \u22411 \u21306 \u20998 \u30495 \u23454 \u35266 \u27979 \u12289 \u25554 \u34917 \u32467 \u26524 \u20197 \u21450 \u36830 \u32493 \u31163 \u32447 \u29366 \u24577 \u65292 \u20351 \'93\u35266 \u27979 \u36807 \u31243 \'94\u26412 \u36523 \u21442 \u19982 \u29366 \u24577 \u34920 \u31034 \u23398 \u20064 \u12290 \u30456 \u27604 \u20256 \u32479 \u20808 \u25554 \u34917 \u20877 \u39044 \u27979 \u30340 \u26041 \u27861 \u65292 \u35813 \u30740 \u31350 \u36827 \u19968 \u27493 \u24378 \u35843 \u32570 \u22833 \u27169 \u24335 \u21487 \u33021 \u19981 \u20165 \u26159 \u25968 \u25454 \u22122 \u22768 \u65292 \u36824 \u21487 \u33021 \u19982 \u35774 \u22791 \u36816 \u34892 \u29366 \u24577 \u12289 \u36864 \u21270 \u36807 \u31243 \u21644 \u39118 \u38505 \u28436 \u21270 \u23384 \u22312 \u20851 \u32852 \u12290 \u35813 \u35270 \u35282 \u26377 \u21161 \u20110 \u34917 \u20805 \u35268 \u21017 \u37319 \u26679 \u26102 \u38388 \u24207 \u21015 \u24314 \u27169 \u20013 \u23545 \u32570 \u22833 \u26426 \u21046 \u32771 \u34385 \u19981 \u36275 \u30340 \u38382 \u39064 \u65292 \u20063 \u20026 \u24322 \u27493 \u26102 \u38388 \u24207 \u21015 \u12289 \u36830 \u32493 \u26102 \u38388 \u21160 \u24577 \u27169 \u22411 \u21644 \u24037 \u19994 \u29366 \u24577 \u39044 \u27979 \u20043 \u38388 \u30340 \u32852 \u31995 \u25552 \u20379 \u26032 \u30340 \u20998 \u26512 \u35282 \u24230 \u12290 \
\uc0\u22312 \u32852 \u21512 \u27010 \u29575 \u29366 \u24577 \u24314 \u27169 \u26041 \u38754 \u65292 \u26412 \u30740 \u31350 \u20851 \u27880 \u24037 \u19994 \u22810 \u20256 \u24863 \u22120 \u20043 \u38388 \u30340 \u21327 \u21516 \u36864 \u21270 \u19982 \u30456 \u20851 \u19981 \u30830 \u23450 \u24615 \u34920 \u36798 \u12290 \u20256 \u32479 \u28857 \u39044 \u27979 \u26041 \u27861 \u36890 \u24120 \u23558 \u26410 \u26469 \u29366 \u24577 \u35270 \u20026 \u30830 \u23450 \u20540 \u65292 \u33021 \u22815 \u21453 \u26144 \u24179 \u22343 \u35823 \u24046 \u65292 \u21364 \u38590 \u20197 \u21051 \u30011 \u21464 \u37327 \u20043 \u38388 \u30340 \u32852 \u21512 \u21464 \u21270 \u36235 \u21183 \u19982 \u23614 \u37096 \u39118 \u38505 \u65307 \u37096 \u20998 \u29420 \u31435 \u27010 \u29575 \u36755 \u20986 \u26041 \u27861 \u34429 \u28982 \u33021 \u22815 \u32473 \u20986 \u21333 \u21464 \u37327 \u21306 \u38388 \u20272 \u35745 \u65292 \u20294 \u23545 \u20110 \u22810 \u21464 \u37327 \u21327 \u21516 \u24322 \u24120 \u21644 \u32852 \u21512 \u36864 \u21270 \u20851 \u31995 \u30340 \u34920 \u36798 \u33021 \u21147 \u20173 \u28982 \u26377 \u38480 \u12290 \u26412 \u25991 \u20174 \u26465 \u20214 \u27010 \u29575 \u24314 \u27169 \u35282 \u24230 \u20986 \u21457 \u65292 \u23558 \u26410 \u26469 \u22810 \u20256 \u24863 \u22120 \u29366 \u24577 \u35270 \u20026 \u26465 \u20214 \u32852 \u21512 \u20998 \u24067 \u36827 \u34892 \u23398 \u20064 \u65292 \u26377 \u21161 \u20110 \u36827 \u19968 \u27493 \u20998 \u26512 \u24037 \u19994 \u26102 \u38388 \u24207 \u21015 \u20013 \u30340 \u21464 \u37327 \u30456 \u20851 \u32467 \u26500 \u12289 \u38543 \u26426 \u36864 \u21270 \u20851 \u31995 \u20197 \u21450 \u19981 \u30830 \u23450 \u24615 \u20256 \u25773 \u26426 \u21046 \u12290 \u35813 \u30740 \u31350 \u33021 \u22815 \u25299 \u23637 \u24037 \u19994 \u27010 \u29575 \u39044 \u27979 \u26041 \u27861 \u65292 \u20351 \u20854 \u20174 \u21333 \u21464 \u37327 \u21306 \u38388 \u20272 \u35745 \u36827 \u19968 \u27493 \u21457 \u23637 \u21040 \u22810 \u21464 \u37327 \u32852 \u21512 \u29366 \u24577 \u20998 \u24067 \u24314 \u27169 \u12290 \
\uc0\u22312 \u39118 \u38505 \u35780 \u20272 \u26041 \u38754 \u65292 \u26412 \u30740 \u31350 \u36827 \u19968 \u27493 \u20851 \u27880 \u39044 \u27979 \u20998 \u24067 \u19982 \u24037 \u19994 \u39118 \u38505 \u25512 \u26029 \u20043 \u38388 \u30340 \u32852 \u31995 \u12290 \u29616 \u26377 \u24037 \u19994 \u39118 \u38505 \u35780 \u20272 \u30740 \u31350 \u24448 \u24448 \u23558 \u39118 \u38505 \u39044 \u35686 \u35270 \u20026 \u29420 \u31435 \u20998 \u31867 \u20219 \u21153 \u65292 \u32780 \u39044 \u27979 \u27169 \u22411 \u19982 \u39118 \u38505 \u27169 \u22411 \u20043 \u38388 \u32570 \u23569 \u32479 \u19968 \u32852 \u31995 \u12290 \u26412 \u25991 \u23581 \u35797 \u22522 \u20110 \u26410 \u26469 \u29366 \u24577 \u20998 \u24067 \u25512 \u23548 \u39118 \u38505 \u27010 \u29575 \u12289 \u21306 \u38388 \u35206 \u30422 \u21644 \u39044 \u35686 \u25351 \u26631 \u65292 \u20351 \u39118 \u38505 \u35780 \u20272 \u36807 \u31243 \u33021 \u22815 \u19982 \u26410 \u26469 \u29366 \u24577 \u39044 \u27979 \u24418 \u25104 \u32479 \u19968 \u20998 \u26512 \u26694 \u26550 \u12290 \u35813 \u30740 \u31350 \u26377 \u21161 \u20110 \u36827 \u19968 \u27493 \u20998 \u26512 \u39044 \u27979 \u19981 \u30830 \u23450 \u24615 \u19982 \u39118 \u38505 \u21028 \u21035 \u20043 \u38388 \u30340 \u20851 \u31995 \u65292 \u24182 \u25512 \u21160 \u24037 \u19994 \u29366 \u24577 \u39044 \u27979 \u20174 \u21333 \u32431 \u35823 \u24046 \u20248 \u21270 \u36880 \u28176 \u36716 \u21521 \u20860 \u39038 \u27010 \u29575 \u21487 \u20449 \u24615 \u19982 \u39118 \u38505 \u21487 \u29992 \u24615 \u30340 \u24314 \u27169 \u26041 \u24335 \u12290 \
\uc0\u24635 \u20307 \u26469 \u30475 \u65292 \u20174 \u24322 \u27493 \u35266 \u27979 \u12289 \u22810 \u21464 \u37327 \u32852 \u21512 \u29366 \u24577 \u24314 \u27169 \u20197 \u21450 \u39118 \u38505 \u25512 \u26029 \u19977 \u20010 \u23618 \u38754 \u30740 \u31350 \u24037 \u19994 \u35774 \u22791 \u29366 \u24577 \u39044 \u27979 \u38382 \u39064 \u65292 \u26377 \u21161 \u20110 \u21152 \u24378 \u19981 \u35268 \u21017 \u26102 \u38388 \u24207 \u21015 \u24314 \u27169 \u12289 \u27010 \u29575 \u39044 \u27979 \u19982 \u24037 \u19994 \u39118 \u38505 \u35780 \u20272 \u20043 \u38388 \u30340 \u20132 \u21449 \u30740 \u31350 \u65292 \u24182 \u20026 \u22797 \u26434 \u24037 \u19994 \u30417 \u27979 \u29615 \u22659 \u19979 \u30340 \u39044 \u27979 \u24615 \u32500 \u25252 \u30740 \u31350 \u25552 \u20379 \u26032 \u30340 \u29702 \u35770 \u20998 \u26512 \u35270 \u35282 \u12290 \
