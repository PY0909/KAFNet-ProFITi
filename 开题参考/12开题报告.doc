\f2\b\fs21 \cf0 1.2 \uc0\u22269 \u20869 \u22806 \u30740 \u31350 \u29616 \u29366 \
1.2.1 \uc0\u24037 \u19994 \u35774 \u22791 \u29366 \u24577 \u39044 \u27979 \u19982 \u21097 \u20313 \u23551 \u21629 \u30740 \u31350 \u29616 \u29366 \
\pard\pardeftab720\fi420\pardirnatural\qj\partightenfactor0

\f1\b0\fs24 \cf0 \uc0\u24037 \u19994 \u35774 \u22791 \u29366 \u24577 \u39044 \u27979 \u21644 \u21097 \u20313 \u23551 \u21629 \u30740 \u31350 \u24050 \u32463 \u24418 \u25104 \u20102 \u36739 \u20016 \u23500 \u30340 \u26041 \u27861 \u20307 \u31995 \u12290 \u28966 \u23447 \u22799 \u31561 [1]\u22260 \u32469 \u28082 \u21387 \u20803 \u20214 \u21450 \u31995 \u32479 \u26234 \u33021 \u21270 \u21457 \u23637 \u36827 \u34892 \u32508 \u36848 \u65292 \u25351 \u20986 \u29366 \u24577 \u24863 \u30693 \u12289 \u20581 \u24247 \u35780 \u20272 \u21644 \u26234 \u33021 \u36816 \u32500 \u26159 \u35013 \u22791 \u31995 \u32479 \u21457 \u23637 \u30340 \u37325 \u35201 \u26041 \u21521 \u12290 \u29579 \u20964 \u39134 \u31561 [3]\u32771 \u34385 \u38543 \u26426 \u25928 \u24212 \u26500 \u24314 \u22810 \u28304 \u20449 \u24687 \u34701 \u21512 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u26041 \u27861 \u65292 \u30740 \u31350 \u34920 \u26126 \u35774 \u22791 \u20010 \u20307 \u24046 \u24322 \u21644 \u22810 \u28304 \u30417 \u27979 \u20449 \u24687 \u20250 \u20849 \u21516 \u24433 \u21709 \u23551 \u21629 \u39044 \u27979 \u32467 \u26524 \u12290 \u23380 \u38634 \u23792 \u31561 [4]\u32508 \u36848 \u26426 \u26800 \u20135 \u21697 \u22810 \u21464 \u37327 \u30456 \u20381 \u36864 \u21270 \u24314 \u27169 \u26041 \u27861 \u65292 \u35828 \u26126 \u22810 \u25351 \u26631 \u36864 \u21270 \u36807 \u31243 \u20013 \u30340 \u30456 \u20381 \u32467 \u26500 \u20250 \u24433 \u21709 \u21487 \u38752 \u24615 \u24314 \u27169 \u21644 \u32500 \u25252 \u31574 \u30053 \u12290 \u29579 \u23431 \u31561 [5]\u30740 \u31350 \u38750 \u22343 \u21248 \u30417 \u27979 \u26465 \u20214 \u19979 \u28378 \u21160 \u36724 \u25215 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u26041 \u27861 \u65292 \u34920 \u26126 \u19981 \u35268 \u21017 \u30417 \u27979 \u20250 \u22686 \u21152 \u23551 \u21629 \u39044 \u27979 \u38590 \u24230 \u12290 \u38472 \u38383 \u31561 [6]\u32508 \u36848 \u35013 \u22791 \u21097 \u20313 \u23551 \u21629 \u21306 \u38388 \u39044 \u27979 \u30740 \u31350 \u65292 \u35828 \u26126 \u21306 \u38388 \u39044 \u27979 \u33021 \u22815 \u26356 \u30452 \u25509 \u26381 \u21153 \u32500 \u25252 \u20915 \u31574 \u12290 \u24222 \u21746 \u26976 \u31561 [7]\u38754 \u21521 \u19981 \u23436 \u32654 \u32500 \u20462 \u19979 \u30340 \u38543 \u26426 \u36864 \u21270 \u35774 \u22791 \u25552 \u20986 \u33258 \u36866 \u24212 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u26041 \u27861 \u65292 \u24378 \u35843 \u32500 \u20462 \u27963 \u21160 \u23545 \u36864 \u21270 \u36712 \u36857 \u26356 \u26032 \u30340 \u24433 \u21709 \u12290 Cheng\u31561 [8]\u25552 \u20986  Bayesian adversarial probsparse Transformer\u65292 \u29992 \u20110 \u38271 \u26102 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u65292 \u24182 \u36890 \u36807 \u36125 \u21494 \u26031 \u24314 \u27169 \u22686 \u24378 \u39044 \u27979 \u19981 \u30830 \u23450 \u24615 \u34920 \u36798 \u12290 Wang\u31561 [9]\u38754 \u21521 \u38543 \u26426 \u32570 \u22833 \u21644 \u37096 \u20998 \u25925 \u38556 \u20256 \u24863 \u22120 \u25552 \u20986 \u22312 \u32447 \u21097 \u20313 \u23551 \u21629 \u40065 \u26834 \u19981 \u30830 \u23450 \u24615 \u37327 \u21270 \u26041 \u27861 \u65292 \u34920 \u26126 \u30495 \u23454 \u24037 \u19994 \u26465 \u20214 \u19979 \u30340 \u32570 \u22833 \u35266 \u27979 \u21644 \u20256 \u24863 \u22120 \u24322 \u24120 \u38656 \u35201 \u30452 \u25509 \u32435 \u20837 \u27169 \u22411 \u40065 \u26834 \u24615 \u35780 \u20215 \u12290 \u19978 \u36848 \u30740 \u31350 \u35828 \u26126 \u65292 \u24037 \u19994 \u35774 \u22791 \u29366 \u24577 \u39044 \u27979 \u24050 \u32463 \u20174 \u21333 \u19968 \u23551 \u21629 \u22238 \u24402 \u36880 \u28176 \u36716 \u21521 \u22810 \u20256 \u24863 \u22120 \u34701 \u21512 \u12289 \u28145 \u24230 \u26102 \u24207 \u24314 \u27169 \u21644 \u19981 \u30830 \u23450 \u24615 \u37327 \u21270 \u12290 \
\uc0\u22810 \u21464 \u37327 \u30456 \u20851 \u24314 \u27169 \u26159 \u24037 \u19994 \u29366 \u24577 \u39044 \u27979 \u20013 \u30340 \u21478 \u19968 \u37325 \u35201 \u38382 \u39064 \u12290 \u28966 \u23447 \u22799 \u31561 [1]\u24378 \u35843 \u24037 \u19994 \u35774 \u22791 \u29366 \u24577 \u24863 \u30693 \u38656 \u35201 \u32508 \u21512 \u22810 \u31867 \u20256 \u24863 \u22120 \u20449 \u21495 \u65292 \u20005 \u22914 \u24378 \u31561 [2]\u20174 \u24037 \u19994 \u26234 \u33021 \u35786 \u26029 \u21487 \u20449 \u24615 \u35282 \u24230 \u35828 \u26126 \u20808 \u39564 \u30693 \u35782 \u21644 \u21487 \u35299 \u37322 \u26426 \u21046 \u23545 \u25968 \u25454 \u39537 \u21160 \u27169 \u22411 \u30340 \u37325 \u35201 \u20316 \u29992 \u65292 \u23380 \u38634 \u23792 \u31561 [4]\u36827 \u19968 \u27493 \u20174 \u22810 \u21464 \u37327 \u30456 \u20381 \u36864 \u21270 \u24314 \u27169 \u35282 \u24230 \u35828 \u26126 \u19981 \u21516 \u36864 \u21270 \u25351 \u26631 \u19981 \u33021 \u34987 \u31616 \u21333 \u35270 \u20026 \u29420 \u31435 \u21464 \u37327 \u12290 \u23545 \u20110 \u31354 \u27668 \u21387 \u32553 \u26426 \u12289 \u33322 \u31354 \u21457 \u21160 \u26426 \u21644 \u36807 \u31243 \u24037 \u19994 \u35013 \u32622 \u32780 \u35328 \u65292 \u21387 \u21147 \u12289 \u28201 \u24230 \u12289 \u30005 \u27969 \u12289 \u38400 \u20301 \u21644 \u25391 \u21160 \u31561 \u21464 \u37327 \u20043 \u38388 \u21487 \u33021 \u23384 \u22312 \u32806 \u21512 \u21464 \u21270 \u19982 \u21327 \u21516 \u24322 \u24120 \u65292 \u33509 \u27169 \u22411 \u21482 \u36827 \u34892 \u29420 \u31435 \u39044 \u27979 \u65292 \u23601 \u23481 \u26131 \u20302 \u20272 \u22810 \u25351 \u26631 \u21516 \u27493 \u21155 \u21270 \u24102 \u26469 \u30340 \u39118 \u38505 \u12290 \u22240 \u27492 \u65292 \u26412 \u25991 \u23558 \u22810 \u20256 \u24863 \u22120 \u26410 \u26469 \u29366 \u24577 \u35270 \u20026 \u26465 \u20214 \u32852 \u21512 \u20998 \u24067 \u65292 \u32780 \u19981 \u26159 \u22810 \u20010 \u20114 \u19981 \u30456 \u20851 \u30340 \u21333 \u21464 \u37327 \u39044 \u27979 \u20219 \u21153 \u12290 \
1.2.2 \uc0\u35268 \u21017 \u37319 \u26679 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u19982 \u24322 \u27493 \u32570 \u22833 \u24207 \u21015 \u24314 \u27169 \u30740 \u31350 \u29616 \u29366 \
\uc0\u36890 \u29992 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u26041 \u27861 \u20026 \u26412 \u25991 \u22522 \u32447 \u35774 \u35745 \u25552 \u20379 \u20102 \u37325 \u35201 \u20381 \u25454 \u12290 Nie\u31561 [10]\u25552 \u20986  PatchTST\u65292 \u36890 \u36807  patch \u21270 \u36755 \u20837 \u25552 \u21319 \u38271 \u26399 \u39044 \u27979 \u33021 \u21147 \u65307 Wu\u31561 [11]\u25552 \u20986  TimesNet\u65292 \u23558 \u19968 \u32500 \u26102 \u38388 \u24207 \u21015 \u36716 \u25442 \u20026 \u20108 \u32500 \u21464 \u21270 \u32467 \u26500 \u20197 \u25429 \u33719 \u22810 \u21608 \u26399 \u27169 \u24335 \u65307 Liu\u31561 [12]\u25552 \u20986  iTransformer\u65292 \u22312 \u21464 \u37327 \u32500 \u24230 \u36827 \u34892 \u27880 \u24847 \u21147 \u24314 \u27169 \u20197 \u22686 \u24378 \u22810 \u21464 \u37327 \u39044 \u27979 \u65307 Zhou\u31561 [13]\u25552 \u20986  FEDformer\u65292 \u36890 \u36807 \u39057 \u22495 \u20998 \u35299 \u21644 \u39057 \u22495 \u27880 \u24847 \u21147 \u22788 \u29702 \u38271 \u24207 \u21015 \u39044 \u27979 \u65307 Zeng\u31561 [14]\u25552 \u20986 \u30340 \u30740 \u31350 \u21017 \u25552 \u37266 \u65292 \u22312 \u37096 \u20998 \u26102 \u38388 \u24207 \u21015 \u20219 \u21153 \u20013 \u31616 \u21333 \u32447 \u24615 \u27169 \u22411 \u20063 \u20855 \u26377 \u31454 \u20105 \u21147 \u12290 \u19978 \u36848 \u24037 \u20316 \u20849 \u21516 \u35828 \u26126 \u65292 \u35268 \u21017 \u37319 \u26679 \u38271 \u24207 \u21015 \u39044 \u27979 \u27169 \u22411 \u24050 \u32463 \u20855 \u22791 \u36739 \u24378 \u34920 \u36798 \u33021 \u21147 \u65292 \u22240 \u27492 \u26412 \u25991 \u22312 \u32479 \u19968 \u23545 \u27604 \u23454 \u39564 \u20013 \u23558  PatchTST\u12289 iTransformer\u12289 TCN-Gaussian \u31561 \u20316 \u20026 \u24378 \u22522 \u32447 \u65292 \u32780 \u19981 \u26159 \u21482 \u19982 \u24369 \u22522 \u32447 \u27604 \u36739 \u12290 \
\uc0\u20294 \u24037 \u19994 \u22810 \u20256 \u24863 \u22120 \u25968 \u25454 \u24448 \u24448 \u20855 \u26377 \u19981 \u35268 \u21017 \u26102 \u38388 \u25139 \u21644 \u37096 \u20998 \u35266 \u27979 \u29305 \u24449 \u12290 \u29579 \u23431 \u31561 [5]\u20174 \u38750 \u22343 \u21248 \u30417 \u27979 \u19979 \u30340 \u36724 \u25215 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u35282 \u24230 \u35828 \u26126 \u65292 \u30417 \u27979 \u26102 \u38388 \u38388 \u38548 \u21464 \u21270 \u20250 \u25913 \u21464 \u36864 \u21270 \u29305 \u24449 \u34920 \u36798 \u12290 Zhang\u31561 [15]\u25552 \u20986  Graph-Guided Network\u65292 \u36890 \u36807 \u22270 \u32467 \u26500 \u23398 \u20064 \u19981 \u35268 \u21017 \u37319 \u26679 \u22810 \u21464 \u37327 \u26102 \u38388 \u24207 \u21015 \u20013 \u30340 \u21464 \u37327 \u20851 \u31995 \u65307 Ansari\u31561 [16]\u25552 \u20986  Neural Continuous-Discrete State Space Models\u65292 \u20197 \u36830 \u32493 \'97\u31163 \u25955 \u29366 \u24577 \u31354 \u38388 \u24314 \u27169 \u19981 \u35268 \u21017 \u37319 \u26679 \u19979 \u30340 \u28508 \u22312 \u21160 \u24577 \u65307 Yalavarthi\u31561 [17]\u25552 \u20986  GraFITi\u65292 \u29992 \u22270 \u32467 \u26500 \u22788 \u29702 \u19981 \u35268 \u21017 \u37319 \u26679 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u65307 Gravina\u31561 [18]\u25552 \u20986  Temporal Graph ODEs\u65292 \u23558 \u22270 \u31070 \u32463 \u32593 \u32476 \u19982 \u36830 \u32493 \u26102 \u38388  ODE \u32467 \u21512 \u20197 \u22788 \u29702 \u19981 \u35268 \u21017 \u37319 \u26679 \u26102 \u38388 \u24207 \u21015 \u12290 Zhou\u31561 [19]\u25552 \u20986  KAFNet\u65292 \u36890 \u36807 \u35268 \u33539 \u21270 \u39044 \u23545 \u40784 \u22686 \u24378 \u19981 \u35268 \u21017 \u22810 \u21464 \u37327 \u39044 \u27979 \u65292 Yalavarthi\u31561 [20]\u25552 \u20986  ProFITi\u65292 \u20197 \u26465 \u20214 \u27969 \u23454 \u29616 \u19981 \u35268 \u21017 \u26102 \u38388 \u24207 \u21015 \u30340 \u27010 \u29575 \u39044 \u27979 \u12290 \u19978 \u36848 \u30740 \u31350 \u35828 \u26126 \u65292 \u24322 \u27493 \u35266 \u27979 \u24314 \u27169 \u38656 \u35201 \u21516 \u26102 \u22788 \u29702 \u26102 \u38388 \u12289 \u36890 \u36947 \u12289 \u32570 \u22833 \u21644 \u26465 \u20214 \u26597 \u35810 \u65292 \u32780 \u19981 \u33021 \u20165 \u20381 \u36182 \u25554 \u20540 \u21518 \u30340 \u35268 \u21017 \u24207 \u21015 \u12290 \
1.2.3 \uc0\u27010 \u29575 \u39044 \u27979 \u12289 \u19981 \u30830 \u23450 \u24615 \u37327 \u21270 \u19982 \u39118 \u38505 \u35780 \u20272 \u30740 \u31350 \u29616 \u29366 \
\uc0\u27010 \u29575 \u39044 \u27979 \u12289 \u19981 \u30830 \u23450 \u24615 \u37327 \u21270 \u19982 \u39118 \u38505 \u35780 \u20272 \u26159 \u24037 \u19994 \u39044 \u27979 \u24615 \u32500 \u25252 \u20013 \u30340 \u20851 \u38190 \u29615 \u33410 \u12290 \u38472 \u38383 \u31561 [6]\u25351 \u20986 \u35013 \u22791 \u21097 \u20313 \u23551 \u21629 \u39044 \u27979 \u38656 \u35201 \u20174 \u28857 \u20272 \u35745 \u25193 \u23637 \u21040 \u21306 \u38388 \u39044 \u27979 \u65292 \u20197 \u20415 \u34920 \u36798 \u27169 \u22411 \u39044 \u27979 \u30340 \u19981 \u30830 \u23450 \u33539 \u22260 \u12290 Drouin\u31561 [21]\u25552 \u20986  TACTiS\u65292 \u23558  Transformer \u19982  attentional copula \u32467 \u21512 \u65292 \u29992 \u20110 \u22810 \u21464 \u37327 \u26102 \u38388 \u24207 \u21015 \u30340 \u32852 \u21512 \u27010 \u29575 \u39044 \u27979 \u65307 Ashok\u31561 [22]\u25552 \u20986  TACTiS-2\u65292 \u22312 \u20445 \u25345  copula \u34920 \u36798 \u33021 \u21147 \u30340 \u21516 \u26102 \u25552 \u39640 \u22810 \u21464 \u37327 \u27010 \u29575 \u39044 \u27979 \u25928 \u29575 \u12290 Sun\u21644 Yu[23]\u25552 \u20986  Copula Conformal Prediction\u65292 \u30740 \u31350 \u22810 \u27493 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u20013 \u30340 \u32852 \u21512 \u21306 \u38388 \u26657 \u20934 \u65307 Chen\u31561 [24]\u25552 \u20986  Conformalized Time Series with Semantic Features\u65292 \u36827 \u19968 \u27493 \u35752 \u35770 \u35821 \u20041 \u29305 \u24449 \u23545 \u26102 \u38388 \u24207 \u21015 \u19981 \u30830 \u23450 \u24615 \u26657 \u20934 \u30340 \u20316 \u29992 \u12290 \u19978 \u36848 \u30740 \u31350 \u34920 \u26126 \u65292 \u27010 \u29575 \u39044 \u27979 \u19981 \u24212 \u21482 \u20851 \u27880 \u22343 \u20540 \u35823 \u24046 \u65292 \u36824 \u38656 \u35201 \u35780 \u20215  NLL\u12289 CRPS\u12289 \u39044 \u27979 \u21306 \u38388 \u35206 \u30422 \u29575 \u12289 \u21306 \u38388 \u23485 \u24230 \u21644 \u26657 \u20934 \u35823 \u24046 \u12290 \
\uc0\u24037 \u19994 \u39118 \u38505 \u35780 \u20272 \u36824 \u38656 \u35201 \u20851 \u27880 \u24322 \u24120 \u35782 \u21035 \u21644 \u39044 \u35686 \u21487 \u29992 \u24615 \u12290 \u26472 \u32461 \u26222 \u31561 [25]\u32508 \u36848 \u36716 \u21521 \u26550 \u20851 \u38190 \u36816 \u21160 \u37096 \u20214 \u21160 \u21147 \u23398 \u26426 \u29702 \u19982 \u25925 \u38556 \u35786 \u26029 \u65292 \u35828 \u26126 \u26426 \u29702 \u30693 \u35782 \u23545 \u22797 \u26434 \u26426 \u26800 \u31995 \u32479 \u25925 \u38556 \u35782 \u21035 \u20855 \u26377 \u37325 \u35201 \u25903 \u25745 \u20316 \u29992 \u12290 \u26519 \u20140 \u21644 \u28966 \u37329 \u38451 [26]\u32508 \u36848 \u21487 \u35299 \u37322 \u26426 \u26800 \u26234 \u33021 \u35786 \u26029 \u25216 \u26415 \u65292 \u24378 \u35843 \u35786 \u26029 \u27169 \u22411 \u19981 \u20165 \u35201 \u26377 \u39044 \u27979 \u24615 \u33021 \u65292 \u36824 \u38656 \u35201 \u20855 \u22791 \u21487 \u35299 \u37322 \u24615 \u21644 \u21487 \u20449 \u24615 \u12290 \u29279 \u24314 \u40527 \u31561 [27]\u25552 \u20986 \u22522 \u20110 \u21452 \u21521 \u29983 \u25104 \u23545 \u25239 \u32593 \u32476 \u30340 \u24037 \u19994 \u36807 \u31243 \u25925 \u38556 \u26816 \u27979 \u26041 \u27861 \u65292 \u24182 \u22312 \u30000 \u32435 \u35199 \u20234 \u26031 \u26364 \u36807 \u31243 \u21644 \u23454 \u38469 \u30952 \u29028 \u26426 \u24037 \u19994 \u36807 \u31243 \u19978 \u39564 \u35777 \u20854 \u25925 \u38556 \u26816 \u27979 \u33021 \u21147 \u12290 Xu\u31561 [28]\u25552 \u20986  Anomaly Transformer\u65292 \u36890 \u36807 \u20851 \u32852 \u24046 \u24322 \u35782 \u21035 \u26102 \u38388 \u24207 \u21015 \u24322 \u24120 \u65307 Tuli\u31561 [29]\u25552 \u20986  TranAD\u65292 \u21033 \u29992  Transformer \u32593 \u32476 \u36827 \u34892 \u22810 \u21464 \u37327 \u26102 \u38388 \u24207 \u21015 \u24322 \u24120 \u26816 \u27979 \u65307 Yang\u31561 [30]\u25552 \u20986  DCdetector\u65292 \u20197 \u21452 \u27880 \u24847 \u21147 \u23545 \u27604 \u34920 \u31034 \u23398 \u20064 \u25552 \u21319 \u26102 \u38388 \u24207 \u21015 \u24322 \u24120 \u26816 \u27979 \u33021 \u21147 \u12290 Kl\'f6tergens\u31561 [31]\u25552 \u20986  CircuITS\u65292 \u23558 \u27010 \u29575 \u30005 \u36335 \u29992 \u20110 \u19981 \u35268 \u21017 \u22810 \u21464 \u37327 \u26102 \u38388 \u24207 \u21015 \u39044 \u27979 \u65292 \u20026 \u19981 \u35268 \u21017 \u22330 \u26223 \u19979 \u30340 \u27010 \u29575 \u24314 \u27169 \u25552 \u20379 \u20102 \u26032 \u30340 \u26041 \u21521 \u12290 \u36825 \u20123 \u30740 \u31350 \u20026 \u26412 \u25991 \u26500 \u24314  RiskHead\u12289 \u39118 \u38505 \u20998 \u25968 \u12289 \u26657 \u20934 \u26354 \u32447 \u21644 \u39044 \u35686 \u25351 \u26631 \u25552 \u20379 \u20102 \u26041 \u27861 \u21442 \u29031 \u12290 \
\uc0\u24635 \u20307 \u26469 \u30475 \u65292 \u29616 \u26377 \u30740 \u31350 \u24050 \u32463 \u20174 \u35268 \u21017 \u37319 \u26679 \u39044 \u27979 \u12289 \u24322 \u27493 \u26102 \u38388 \u24207 \u21015 \u24314 \u27169 \u12289 \u32852 \u21512 \u27010 \u29575 \u39044 \u27979 \u21644 \u24322 \u24120 \u26816 \u27979 \u31561 \u26041 \u21521 \u24418 \u25104 \u20102 \u36739 \u20016 \u23500 \u30340 \u26041 \u27861 \u22522 \u30784 \u65292 \u20294 \u20173 \u23384 \u22312 \u19968 \u23450 \u23616 \u38480 \u12290 \u35268 \u21017 \u37319 \u26679 \u27169 \u22411 \u39044 \u27979 \u33021 \u21147 \u24378 \u65292 \u21364 \u20381 \u36182 \u21516 \u27493 \u23436 \u25972 \u36755 \u20837 \u65307 \u22270 \u27169 \u22411 \u21644 \u36830 \u32493 \u26102 \u38388 \u27169 \u22411 \u33021 \u22788 \u29702 \u19981 \u35268 \u21017 \u35266 \u27979 \u65292 \u20294 \u35757 \u32451 \u22797 \u26434 \u24230 \u21644 \u39640 \u32500 \u27010 \u29575 \u36755 \u20986 \u20173 \u26159 \u25361 \u25112 \u65307 copula\u12289 flow \u21644  conformal \u26041 \u27861 \u33021 \u22815 \u22686 \u24378 \u19981 \u30830 \u23450 \u24615 \u34920 \u36798 \u65292 \u21364 \u38656 \u35201 \u36827 \u19968 \u27493 \u19982 \u24037 \u19994 \u39118 \u38505 \u26631 \u31614 \u12289 \u39044 \u35686 \u38408 \u20540 \u21644 \u21487 \u22797 \u29616 \u23454 \u39564 \u21327 \u35758 \u32467 \u21512 \u12290 \u22240 \u27492 \u65292 \u38754 \u21521 \u24037 \u19994 \u24322 \u27493 \u22810 \u20256 \u24863 \u22120 \u22330 \u26223 \u65292 \u20173 \u26377 \u24517 \u35201 \u30740 \u31350 \u20860 \u39038 \u22810 \u23610 \u24230 \u35268 \u25972 \u34920 \u31034 \u12289 \u32852 \u21512 \u27010 \u29575 \u36755 \u20986 \u12289 \u21306 \u38388 \u26657 \u20934 \u21644 \u39118 \u38505 \u35780 \u20272 \u30340 \u19968 \u20307 \u21270 \u26041 \u27861 \u12290 \
\uc0\u22312 \u27492 \u22522 \u30784 \u19978 \u65292 \u26412 \u25991 \u23558  KAFNet-ProFITi \u20316 \u20026 \u21021 \u22987 \u25216 \u26415 \u36335 \u32447 \u65292 \u23558 \u24403 \u21069 \u23454 \u29616 \u29256 \u20027 \u27169 \u22411 \u26126 \u30830 \u20026  KST ProbFlow\u12290 \u35813 \u27169 \u22411 \u19981 \u20877 \u31616 \u21333 \u20018 \u32852 \u23436 \u25972  KAFNet \u19982 \u23436 \u25972  ProFITi\u65292 \u32780 \u26159 \u22260 \u32469  MultiScaleKAFEncoder\u12289 DynamicSensorGraphBlock\u12289 QueryConditionAdapter\u12289 LowRankCopulaFlowHead\u12289 QuantileHead \u21644  RiskHead \u26500 \u24314 \u32479 \u19968 \u39044 \u27979 \u26694 \u26550 \u12290 \u35813 \u35843 \u25972 \u33021 \u22815 \u20943 \u23569 \u39640 \u32500  full triangular flow \u30340 \u35757 \u32451 \u19981 \u31283 \u23450 \u24615 \u65292 \u21516 \u26102 \u30452 \u25509 \u36755 \u20986 \u39044 \u27979 \u21306 \u38388 \u21644 \u39118 \u38505 \u20998 \u25968 \u65292 \u20351 \u27169 \u22411 \u26356 \u36148 \u21512 \u24037 \u19994 \u39044 \u27979 \u24615 \u32500 \u25252 \u20013 \u30340 \u27010 \u29575 \u39044 \u27979 \u19982 \u39118 \u38505 \u39044 \u35686 \u38656 \u27714 \u12290 \
